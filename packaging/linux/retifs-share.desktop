[Desktop Entry]
Type=Service
MimeType=application/octet-stream;inode/directory;
X-KDE-ServiceTypes=KonqPopupMenu/Plugin
X-KDE-Protocols=file
Actions=share

# "Share with retifs…" in Dolphin: the selected files, or one folder, inside
# a retifs folder (~/retifs/<library>) become a share of their own (ADR-0021).
[Desktop Action share]
Name=Share with retifs…
Icon=emblem-shared
Exec=sh -c 'out=$(retifs share path "$@" 2>&1) && kdialog --title "Shared with retifs" --msgbox "$out" || kdialog --title "Not shared" --error "$out"' retifs-share %F
